#include <stdio.h>
#include <string.h>

int main()
{
    char str1[100], str2[100], result[200];
    int choice, len, cmp;

    printf("Enter first string: ");
    fgets(str1, sizeof(str1), stdin);
    str1[strcspn(str1, "\n")] = '\0';

    printf("Enter second string: ");
    fgets(str2, sizeof(str2), stdin);
    str2[strcspn(str2, "\n")] = '\0';

    do
    {
        printf("\nSTRING OPERATIONS\n");
        printf("1. Find length of string\n");
        printf("2. Copy string\n");
        printf("3. Concatenate strings\n");
        printf("4. Compare strings\n");
        printf("5. Find character in string\n");
        printf("6. Find substring\n");
        printf("7. Convert string to uppercase\n");
        printf("8. Convert string to lowercase\n");
        printf("9. Reverse string\n");
        printf("10. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                len = strlen(str1);
                printf("Length of first string = %d\n", len);
                break;

            case 2:
                strcpy(result, str1);
                printf("Copied string = %s\n", result);
                break;

            case 3:
                strcpy(result, str1);
                strcat(result, str2);
                printf("Concatenated string = %s\n", result);
                break;

            case 4:
                cmp = strcmp(str1, str2);

                if(cmp == 0)
                    printf("Both strings are equal.\n");
                else if(cmp < 0)
                    printf("First string is smaller than second string.\n");
                else
                    printf("First string is greater than second string.\n");
                break;

            case 5:
            {
                char ch;
                char *ptr;

                printf("Enter character to search: ");
                scanf(" %c", &ch);

                ptr = strchr(str1, ch);

                if(ptr != NULL)
                    printf("Character '%c' found in the string.\n", ch);
                else
                    printf("Character '%c' not found.\n", ch);

                break;
            }

            case 6:
            {
                char sub[100];
                char *ptr;

                printf("Enter substring to search: ");
                scanf(" %99[^\n]", sub);

                ptr = strstr(str1, sub);

                if(ptr != NULL)
                    printf("Substring found.\n");
                else
                    printf("Substring not found.\n");

                break;
            }

            case 7:
            {
                int i;

                for(i = 0; str1[i] != '\0'; i++)
                {
                    if(str1[i] >= 'a' && str1[i] <= 'z')
                        str1[i] = str1[i] - 32;
                }

                printf("Uppercase string = %s\n", str1);
                break;
            }

            case 8:
            {
                int i;

                for(i = 0; str1[i] != '\0'; i++)
                {
                    if(str1[i] >= 'A' && str1[i] <= 'Z')
                        str1[i] = str1[i] + 32;
                }

                printf("Lowercase string = %s\n", str1);
                break;
            }

            case 9:
            {
                int i, j;
                char temp;

                i = 0;
                j = strlen(str1) - 1;

                while(i < j)
                {
                    temp = str1[i];
                    str1[i] = str1[j];
                    str1[j] = temp;

                    i++;
                    j--;
                }

                printf("Reversed string = %s\n", str1);
                break;
            }

            case 10:
                printf("Program terminated.\n");
                break;

            default:
                printf("Invalid choice! Please try again.\n");
        }

    } while(choice != 10);

    return 0;
}
