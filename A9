#include <stdio.h>
#include <stdlib.h>

int main()
{
    FILE *fp1, *fp2;
    int ch;

    // Create source file and write sample data
    fp1 = fopen("source.txt", "w");

    if (fp1 == NULL)
    {
        printf("Error creating source file.\n");
        return 1;
    }

    fprintf(fp1, "Hello World!\nWelcome to C Programming.");
    fclose(fp1);

    // Open source file in read mode
    fp1 = fopen("source.txt", "r");

    // Open destination file in write mode
    fp2 = fopen("destination.txt", "w");

    // Check whether files opened successfully
    if (fp1 == NULL || fp2 == NULL)
    {
        printf("Error opening file.\n");
        if (fp1 != NULL)
            fclose(fp1);
        if (fp2 != NULL)
            fclose(fp2);
        return 1;
    }

    // Copy contents from source to destination
    while ((ch = fgetc(fp1)) != EOF)
    {
        fputc(ch, fp2);
    }

    // Display success message
    printf("File copied successfully.\n");

    // Close both files
    fclose(fp1);
    fclose(fp2);

    // Display destination file contents
    fp2 = fopen("destination.txt", "r");

    if (fp2 != NULL)
    {
        printf("\nContents of destination file:\n");

        while ((ch = fgetc(fp2)) != EOF)
        {
            putchar(ch);
        }

        fclose(fp2);
    }

    return 0;
}
