#include <stdio.h>

int main()
{
    int year, month, day;
    int days, firstDay;
    int i, j;
    int leap;

    char *months[] = {
        "January", "February", "March",
        "April", "May", "June",
        "July", "August", "September",
        "October", "November", "December"
    };

    printf("Enter year: ");
    scanf("%d", &year);

    // Check leap year
    if (year % 400 == 0)
        leap = 1;
    else if (year % 100 == 0)
        leap = 0;
    else if (year % 4 == 0)
        leap = 1;
    else
        leap = 0;

    // Calculate first day of January
    firstDay = (year + (year-1)/4 - (year-1)/100
                + (year-1)/400) % 7;

    // Print all 12 months
    for (month = 0; month < 12; month++)
    {
        printf("\n\n       %s %d\n", months[month], year);
        printf(" Sun Mon Tue Wed Thu Fri Sat\n");

        if (month == 1)
        {
            if (leap)
                days = 29;
            else
                days = 28;
        }
        else if (month == 3 || month == 5 ||
                 month == 8 || month == 10)
        {
            days = 30;
        }
        else
        {
            days = 31;
        }

        // Print spaces before first day
        for (i = 0; i < firstDay; i++)
            printf("    ");

        // Print dates
        for (day = 1; day <= days; day++)
        {
            printf("%4d", day);

            if ((firstDay + day) % 7 == 0)
                printf("\n");
        }

        // Calculate first day of next month
        firstDay = (firstDay + days) % 7;
    }

    printf("\n");

    return 0;
}
